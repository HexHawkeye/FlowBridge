@page
@model FlowBridge.Web.Pages.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<div class="page-head"><div><p class="eyebrow">ADMINISTRATION</p><h1>Sign in</h1></div></div>
<form method="post" class="editor" style="max-width:520px">
    <div asp-validation-summary="All" class="validation"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label>Username<input asp-for="Username" autocomplete="username" /></label>
    <label>Password<input asp-for="Password" type="password" autocomplete="current-password" /></label>
    <button type="submit">Sign in</button>
</form>
